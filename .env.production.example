# =============================================================================
# poe1-suite — production env vars (Render)
# =============================================================================
# Set these via the Render dashboard (service → Environment) or the
# `render env` CLI for the deployed backend.
# DO NOT commit a real .env.production with secrets.

ENVIRONMENT=production
LOG_LEVEL=INFO
LOG_FORMAT=json

# Bind to all interfaces inside the container — Render health checks
# reach the container on the internal network.
HOST=0.0.0.0
# PORT is injected by Render (8080 by default; pinned in render.yaml).

# CORS — REQUIRED in production. Replace with the actual Vercel URL once
# the frontend is deployed.
CORS_ALLOWED_ORIGINS=https://fob-ten.vercel.app

# Cache lives on the container's ephemeral fs (Render free tier has no
# persistent disk; the cache is wiped on every redeploy / spin-down).
CACHE_DIR=/tmp/.cache_http

# Defaults for the rest are fine — adjust HTTP_MAX_CONCURRENT_PER_HOST
# upward if the Render plan is bigger.
HTTP_TIMEOUT_SECONDS=15
HTTP_MAX_RETRIES=3
HTTP_CACHE_TTL_SECONDS=3600
HTTP_MAX_CONCURRENT_PER_HOST=4

# Current league — must match the active poe.ninja league string.
POE_LEAGUE=Mirage

# Optional secrets — leave unset unless you specifically need them.
# POESESSID=                 # NOT recommended in multi-user deploys.
# ANTHROPIC_API_KEY=         # Costs money; rule-based fallback is fine.
