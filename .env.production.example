# =============================================================================
# poe1-suite — production env vars (Fly.io)
# =============================================================================
# Set these via `flyctl secrets set KEY=value` for the deployed backend.
# DO NOT commit a real .env.production with secrets.

ENVIRONMENT=production
LOG_LEVEL=INFO
LOG_FORMAT=json

# Bind to all interfaces inside the container — Fly.io health checks
# reach the VM on the internal network.
HOST=0.0.0.0
# PORT is injected by Fly.io (defaults to 8080).

# CORS — REQUIRED in production. Replace with the actual Vercel URL once
# the frontend is deployed.
CORS_ALLOWED_ORIGINS=https://fob-ten.vercel.app

# Cache lives on Fly.io's ephemeral fs; the volume mount path can be
# adjusted in fly.toml.
CACHE_DIR=/data/.cache_http

# Defaults for the rest are fine — adjust HTTP_MAX_CONCURRENT_PER_HOST
# upward if Fly.io machine is bigger.
HTTP_TIMEOUT_SECONDS=15
HTTP_MAX_RETRIES=3
HTTP_CACHE_TTL_SECONDS=3600
HTTP_MAX_CONCURRENT_PER_HOST=4

# Current league — must match the active poe.ninja league string.
POE_LEAGUE=Mirage

# Optional secrets — leave unset unless you specifically need them.
# POESESSID=                 # NOT recommended in multi-user deploys.
# ANTHROPIC_API_KEY=         # Costs money; rule-based fallback is fine.
