# =============================================================================
# poe1-suite — example environment file (development defaults)
# =============================================================================
# Copy to `.env` and fill in only what you need. All values are optional;
# defaults are sane for local dev.

# --- App runtime ---
# 'development' is the default. Set to 'production' on Fly.io to switch
# logging to JSON and require explicit CORS allowed origins.
ENVIRONMENT=development

LOG_LEVEL=INFO
LOG_FORMAT=console
CACHE_DIR=./.cache_http
HTTP_TIMEOUT_SECONDS=15
HTTP_MAX_RETRIES=3
HTTP_CACHE_TTL_SECONDS=3600
HTTP_MAX_CONCURRENT_PER_HOST=4

# --- CORS (production only) ---
# In dev keep empty — the Vite proxy handles cross-origin in development.
# In production set to your deployed frontend URL(s), comma-separated.
# Example: CORS_ALLOWED_ORIGINS=https://fob.vercel.app,https://fob.tools
CORS_ALLOWED_ORIGINS=

# --- PoE league ---
# Slug of the current league. Examples: "Settlers", "Necropolis", "Standard".
POE_LEAGUE=Standard

# --- poe.ninja ---
POE_NINJA_BASE_URL=https://poe.ninja/api/data

# --- GGG official APIs (optional) ---
# Only needed for authenticated trade API calls.
# Get from pathofexile.com cookies (DevTools → Application → Cookies → POESESSID).
# DO NOT use a personal POESESSID in a multi-user deployment — share rate
# limit attaches to the cookie's account and can result in a ban.
POESESSID=

# --- LLM (optional, for FOB Intent Engine fallback) ---
# Anthropic Claude API key. Without it, the IntentExtractor falls back to
# rule-based parsing (15 fixture cases). With it, the LLM (Haiku) covers
# free-text Italian queries. Estimated cost: ~$0.01 per request.
ANTHROPIC_API_KEY=
