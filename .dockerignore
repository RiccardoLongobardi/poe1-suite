# =============================================================================
# .dockerignore — keep the build context tiny and the image smaller
# =============================================================================
# This file is critical: by default `docker build` ships the entire
# working directory to the daemon. Without these excludes the context
# would balloon with .venv / node_modules / git history / tests /
# fixtures. None of that belongs in a production image.

# --- Local environments ---
.venv/
.cache_http/
.cache/
**/__pycache__/
*.pyc
*.pyo
*.pyd
*.so

# --- Frontend (ships separately to Vercel) ---
apps/shell/
**/node_modules/
**/dist/
**/.vite/

# --- Tests + fixtures (production image doesn't run pytest) ---
**/tests/
**/test_*.py
**/conftest.py
.pytest_cache/

# --- Editor / OS / VCS ---
.git/
.github/
.gitignore
.gitattributes
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# --- Build / packaging artifacts ---
*.egg-info/
build/
dist/
htmlcov/
.coverage
.coverage.*
coverage.xml

# --- Tool caches ---
.mypy_cache/
.ruff_cache/
.tox/
pytest-cache-files-*/

# --- Secrets / local-only env files ---
.env
.env.*
!.env.example
!.env.production.example

# --- Docs / repo metadata not needed at runtime ---
docs/
*.md
!README.md
LICENSE.md
CHANGELOG.md
CONTRIBUTING.md

# --- Pre-commit / CI configs ---
.pre-commit-config.yaml
.editorconfig

# --- Claude Code worktrees ---
.claude/

# --- Misc ---
*.log
*.tmp
*.bak
